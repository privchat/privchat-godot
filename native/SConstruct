#!/usr/bin/env python
# SConstruct for the privchat GDExtension (wraps privchat-sdk-c-api).
import os
import sys

env = SConscript("godot-cpp/SConstruct")

# privchat-sdk location: scons CLI var > $SDK_REPO env (set by build.sh) >
# sibling checkout of this repository. SDK_INCLUDE / SDK_LIB_DIR may be
# overridden independently for unusual layouts.
sdk_repo = ARGUMENTS.get("SDK_REPO", os.environ.get("SDK_REPO", ""))
if not sdk_repo:
    sdk_repo = os.path.abspath(os.path.join(os.getcwd(), "..", "..", "privchat-sdk"))

SDK_INCLUDE = ARGUMENTS.get(
    "SDK_INCLUDE",
    os.environ.get(
        "SDK_INCLUDE",
        os.path.join(sdk_repo, "crates", "privchat-sdk-c-api", "include"),
    ),
)
SDK_LIB_DIR = ARGUMENTS.get(
    "SDK_LIB_DIR",
    os.environ.get("SDK_LIB_DIR", os.path.join(sdk_repo, "target", "release")),
)

if not os.path.isfile(os.path.join(SDK_INCLUDE, "privchat_sdk_c_api.h")):
    print(
        "ERROR: privchat_sdk_c_api.h not found under %s\n"
        "Fix: run via native/build.sh, or pass SDK_REPO=/path/to/privchat-sdk "
        "(or SDK_INCLUDE=... SDK_LIB_DIR=...) to scons." % SDK_INCLUDE,
        file=sys.stderr,
    )
    sys.exit(1)

# 只吃 privchat-sdk-c-api 的 C ABI 头;本扩展不接触 UniFFI 生成物。
env.Append(CPPPATH=["#src", SDK_INCLUDE])

if env["platform"] == "macos":
    # Godot engine 4.3+ requires C++17.
    env.Append(CCFLAGS=["-std=c++17"])
    # Link the Rust c-api dylib; @loader_path lets us ship it next to the
    # extension binary (build.sh copies it into addons/privchat/bin).
    env.Append(LINKFLAGS=[
        "-Wl,-rpath,@loader_path",
        "-Wl,-rpath," + SDK_LIB_DIR,
    ])
    env.Append(LIBPATH=[SDK_LIB_DIR])
    env.Append(LIBS=["privchat_sdk_c_api"])

    library = env.SharedLibrary(
        target="../addons/privchat/bin/libprivchat_godot.{}.{}.dylib".format(
            env["platform"], env["target"]
        ),
        source=Glob("src/*.cpp"),
    )
else:
    print("Only macOS targets are supported in this phase.")
    sys.exit(1)

Default(library)
